{
  "triple": "x86_64-unknown-none-elf",
  "arch": "x86_64",
  "vendor": "unknown",
  "os": "none",
  "env": null,
  "data-layout": "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "pointer-width": 64,
  "endian": "little",
  "target-family": ["none"],
  "llvm-target": "x86_64-unknown-none-elf",
  "cpu": "generic",
  "target-features": [
    "-mmx",
    "-sse",
    "-sse2",
    "-sse3",
    "-ssse3",
    "-sse4.1",
    "-sse4.2",
    "-avx",
    "-avx2",
    "-avx512f",
    "-avx512vl",
    "-avx512bw",
    "-avx512dq",
    "-fma",
    "-fma4",
    "-xop",
    "+soft-float"
  ],
  "reloc-mode": "static",
  "code-models": ["small", "kernel"],
  "runtime": "none",
  "default-code-model": "kernel",
  "has-float": false,
  "requires-no-std": true,
  "emit": "x86_64-bare",
  "linker": "ld.lld",
  "linker-flavor": "lld",
  "linker-args": ["-m", "elf_x86_64", "--static", "--no-undefined", "--fatal-warnings", "--build-id=none"],
  "is-like-bare": true
}
