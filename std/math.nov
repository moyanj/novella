// IEEE-754 双精度常量。
pub const PI: f64 = 3.141592653589793;
pub const E: f64 = 2.718281828459045;

// f64 绝对值：NaN 与 ±inf 原样返回，-0.0 返回 +0.0（IEEE 规定）。
pub func fabs(x: f64) -> f64 {
    if (x <= 0.0) { return -x; }
    if (x > 0.0) { return x; }
    return x;
}

// `|x| >= 2^63` 的阈值：此处上 f64 已无小数位，取整即原值。
// 该值必须严格小于 2^63，否则 `x as i64` 在 2^63 本身即溢出。
pri func beyondIntegerRange(x: f64) -> boolean {
    let limit: f64 = 9223372036854775808.0;
    if (x >= limit) { return true; }
    if (x <= -limit) { return true; }
    return false;
}

// 向零取整：区间内靠 `as i64` 截断（硬件截断指令），越界时 f64 已无小数位，原样返回。
// 注意 `x / 1.0` 在 IEEE-754 下不取整，不能用于整数化。
pub func trunc(x: f64) -> f64 {
    if (beyondIntegerRange(x)) { return x; }
    return (x as i64) as f64;
}

// 向上取整：先截断，有小数余量再加一。NaN 与 ±inf 因比较为假而原样返回。
pub func ceil(x: f64) -> f64 {
    if (beyondIntegerRange(x)) { return x; }
    let whole = (x as i64) as f64;
    if (whole < x) { return whole + 1.0; }
    return whole;
}

// 向下取整：先截断，有小数余量再减一。
pub func floor(x: f64) -> f64 {
    if (beyondIntegerRange(x)) { return x; }
    let whole = (x as i64) as f64;
    if (whole > x) { return whole - 1.0; }
    return whole;
}

// 四舍五入；沿用旧实现的规则——正半轴与向上取整相同，负半轴向远离零取整。
// 即 `.5` 一律远离零（2.5 -> 3、-2.5 -> -3），不做银行家舍入。
pub func round(x: f64) -> f64 {
    if (beyondIntegerRange(x)) { return x; }
    let whole = (x as i64) as f64;
    let rest = x - whole;
    if (x >= 0.0) {
        if (rest >= 0.5) { return whole + 1.0; }
        return whole;
    }
    if (rest <= -0.5) { return whole - 1.0; }
    return whole;
}

// 平方根：初值取 x 的一半，Newton 迭代 y <- (y + x / y) 的一半。
// 停止条件用相邻两次的相对变化，2^-50 的阈值大于 Newton 末段两个候选值的差，
// 因此必然终止；NaN 与正无穷会让比较为假而立即返回。
pub func sqrt(x: f64) -> f64 {
    if (x <= 0.0) { return 0.0; }
    let tolerance: f64 = 0.0000000000000008881784197001252;
    let half: f64 = 0.5;
    let guess = x * half;
    let next = (guess + x / guess) * half;
    while (fabs(next - guess) > next * tolerance) {
        guess = next;
        next = (guess + x / guess) * half;
    }
    return next;
}

// 对 i64::MIN 也成立：先平移再取负，避免有符号溢出。
pub func abs(x: i64) -> u64 {
    if (x >= 0) { return x as u64; }
    return (-(x + 1) as u64) + 1;
}

pub func min(a: i64, b: i64) -> i64 {
    if (a < b) { return a; }
    return b;
}

pub func max(a: i64, b: i64) -> i64 {
    if (a > b) { return a; }
    return b;
}
