// UTF-16 字符串。系统边界为分配、释放、终止与 C11 固定 ABI 浮点格式化。
extern func strfromd(buffer: u8*, size: usize, format: u8*, value: f64) -> i32;
extern func novella_rt_malloc(size: usize) -> void*;
extern func novella_rt_free(data: void*);
extern func abort();

pub class String {
    pri data: u16*;
    pri len: usize;

    pub func __init(self) {
        this.data = null;
        this.len = 0;
    }

    pub func __destroy(self) {
        unsafe {
            novella_rt_free(this.data);
        }
    }

    // 十进制整数格式化仅用标准库算法；无符号路径保留 u64 最大值。
    pub static func fromUnsigned(value: u64) -> String {
        let digits: usize = 1;
        let remaining: u64 = value;
        while (remaining >= 10) {
            remaining /= 10;
            digits += 1;
        }
        let result = new String();
        result.len = digits;
        unsafe {
            result.data = novella_rt_malloc(digits * 2) as u16*;
            if (result.data == null) { abort(); return null; }
            remaining = value;
            let index = digits;
            while (index > 0) {
                index -= 1;
                result.data[index] = ((remaining % 10) as u16) + 48;
                remaining /= 10;
            }
        }
        return result;
    }

    pub static func fromInteger(value: i64) -> String {
        if (value >= 0) { return String.fromUnsigned(value as u64); }
        // 避免对 i64 最小值直接取负；先平移一个单位再还原无符号幅值。
        let magnitude: u64 = (-(value + 1) as u64) + 1;
        return "-" + String.fromUnsigned(magnitude);
    }

    pub static func fromBoolean(value: boolean) -> String {
        if (value) { return "true"; }
        return "false";
    }

    // g 格式有效数字：f32 用 9 位、f64 用 17 位；包含负零、inf 和 nan。
    pub static func fromFloat32(value: f32) -> String {
        return String.formatFloat(value as f64, true);
    }

    pub static func fromFloat64(value: f64) -> String {
        return String.formatFloat(value, false);
    }

    pri static func formatFloat(value: f64, single: boolean) -> String {
        unsafe {
            let format = novella_rt_malloc(6) as u8*;
            let buffer = novella_rt_malloc(64) as u8*;
            if (format == null or buffer == null) {
                novella_rt_free(format);
                novella_rt_free(buffer);
                abort();
                return null;
            }
            format[0] = 37;
            format[1] = 46;
            if (single) {
                format[2] = 57;
                format[3] = 103;
                format[4] = 0;
            } else {
                format[2] = 49;
                format[3] = 55;
                format[4] = 103;
                format[5] = 0;
            }
            let count = strfromd(buffer, 64, format, value);
            novella_rt_free(format);
            if (count < 0 or count >= 64) {
                novella_rt_free(buffer);
                abort();
                return null;
            }
            let result = new String();
            result.len = count as usize;
            result.data = novella_rt_malloc(result.len * 2) as u16*;
            if (result.data == null) {
                novella_rt_free(buffer);
                abort();
                return null;
            }
            let index: usize = 0;
            while (index < result.len) {
                result.data[index] = buffer[index] as u16;
                index += 1;
            }
            novella_rt_free(buffer);
            return result;
        }
    }

    // 长度和切片下标均以 UTF-16 码元计。
    pub func length(self) -> usize {
        return this.len;
    }

    pub func byteLength(self) -> usize {
        return this.len * 2;
    }

    pub func codeUnitAt(self, index: usize) -> u16 {
        if (index >= this.len) {
            unsafe { abort(); }
            return 0;
        }
        unsafe { return this.data[index]; }
    }

    pub func charCount(self) -> usize {
        let count: usize = 0;
        let index: usize = 0;
        while (index < this.len) {
            let unit = this.codeUnitAt(index);
            index += 1;
            if (unit >= 0xD800 and unit <= 0xDBFF and index < this.len) {
                let next = this.codeUnitAt(index);
                if (next >= 0xDC00 and next <= 0xDFFF) {
                    index += 1;
                }
            }
            count += 1;
        }
        return count;
    }

    pub func equals(self, other: String) -> boolean {
        if (other == null) { return false; }
        if (this.len != other.len) { return false; }
        let index: usize = 0;
        while (index < this.len) {
            if (this.codeUnitAt(index) != other.codeUnitAt(index)) {
                return false;
            }
            index += 1;
        }
        return true;
    }

    pub func compare(self, other: String) -> i32 {
        let index: usize = 0;
        while (index < this.len and index < other.len) {
            let left = this.codeUnitAt(index);
            let right = other.codeUnitAt(index);
            if (left < right) { return -1; }
            if (left > right) { return 1; }
            index += 1;
        }
        if (this.len < other.len) { return -1; }
        if (this.len > other.len) { return 1; }
        return 0;
    }

    pub func concat(self, other: String) -> String {
        if (other == null) {
            unsafe { abort(); }
            return null;
        }
        let limit: usize = ((-1 as isize) as usize) / 2;
        if (this.len > limit or other.len > limit - this.len) {
            unsafe { abort(); }
            return null;
        }
        let result = new String();
        result.len = this.len + other.len;
        if (result.len == 0) { return result; }
        unsafe {
            result.data = novella_rt_malloc(result.len * 2) as u16*;
            if (result.data == null) {
                abort();
                return null;
            }
            let index: usize = 0;
            while (index < this.len) {
                result.data[index] = this.data[index];
                index += 1;
            }
            index = 0;
            while (index < other.len) {
                result.data[this.len + index] = other.data[index];
                index += 1;
            }
        }
        return result;
    }

    pub func slice(self, start: usize, length: usize) -> String {
        if (start > this.len or length > this.len - start) {
            unsafe { abort(); }
            return null;
        }
        let result = new String();
        result.len = length;
        if (length == 0) { return result; }
        unsafe {
            result.data = novella_rt_malloc(length * 2) as u16*;
            if (result.data == null) {
                abort();
                return null;
            }
            let index: usize = 0;
            while (index < length) {
                result.data[index] = this.data[start + index];
                index += 1;
            }
        }
        return result;
    }

    // ---- 码元读写（供 `std:io` 等定义环境外的模块使用）----
    // 字段是 `pri`，只有定义环境（本文件）能直接读写，因此与编码相关的字节访问
    // 以成员方法形式提供，外部模块只看到安全签名。

    // 以 `u16` 读出第 `index` 个码元（不越界校验，调用方须保证 `index < length()`）。
    pub func unitAt(self, index: usize) -> u16 {
        let unit: u16 = 0;
        unsafe { unit = this.data[index]; }
        return unit;
    }

    // 把全部码元按 UTF-8 写入 `out`，返回写入的字节数；孤立代理码元写 U+FFFD。
    // `out` 至少需要 `length() * 3 + 4` 字节。
    pri func encodeUtf8(self, out: u8*) -> usize {
        let used: usize = 0;
        let index: usize = 0;
        while (index < this.len) {
            let unit = this.unitAt(index);
            index += 1;
            let code: u32 = unit as u32;
            if (unit >= 0xD800 and unit <= 0xDBFF) {
                let lone: boolean = true;
                if (index < this.len) {
                    let next = this.unitAt(index);
                    if (next >= 0xDC00 and next <= 0xDFFF) {
                        lone = false;
                        index += 1;
                        code = 0x10000 + ((code - 0xD800) << 10) + ((next as u32) - 0xDC00);
                    }
                }
                if (lone) {
                    code = 0xFFFD;
                }
            } else if (unit >= 0xDC00 and unit <= 0xDFFF) {
                code = 0xFFFD;
            }
            let at = used;
            unsafe {
                if (code < 0x80) {
                    out[at] = code as u8;
                    used += 1;
                } else if (code < 0x800) {
                    out[at] = (0xC0 + (code >> 6)) as u8;
                    out[at + 1] = (0x80 + (code & 0x3F)) as u8;
                    used += 2;
                } else if (code < 0x10000) {
                    out[at] = (0xE0 + (code >> 12)) as u8;
                    out[at + 1] = (0x80 + ((code >> 6) & 0x3F)) as u8;
                    out[at + 2] = (0x80 + (code & 0x3F)) as u8;
                    used += 3;
                } else {
                    out[at] = (0xF0 + (code >> 18)) as u8;
                    out[at + 1] = (0x80 + ((code >> 12) & 0x3F)) as u8;
                    out[at + 2] = (0x80 + ((code >> 6) & 0x3F)) as u8;
                    out[at + 3] = (0x80 + (code & 0x3F)) as u8;
                    used += 4;
                }
            }
        }
        return used;
    }

    // 以 UTF-8 字节写出自身，返回字节数；需要调用方提供 `length() * 3 + 4` 字节的缓冲区。
    pub func writeUtf8(self, out: u8*) -> usize {
        return this.encodeUtf8(out);
    }
}
