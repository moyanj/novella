@no_std;

extern func novella_rt_alloc(size: usize, alignment: usize, destroy: (void*) -> void) -> void*;
extern func novella_rt_retain(object: void*);
extern func novella_rt_release(object: void*);
extern func novella_rt_weak_create(object: void*) -> void*;
extern func novella_rt_weak_release(handle: void*);
extern func novella_rt_weak_upgrade(handle: void*) -> void*;
extern func putchar(character: i32) -> i32;
extern func abort();

// x86-64 的一个指针槽位：父对象拥有 child，子对象持有 parent 的 weak 控制块。
// 保留 no_std 与显式指针操作，独立演示底层 runtime ABI，不依赖自动 class ARC。
func destroyParent(object: void*) {
    unsafe {
        novella_rt_release(*(object as void**));
        putchar(80);
    }
}

func destroyChild(object: void*) {
    // 只释放 weak 控制块，不对已过期的 parent 载荷调用 release。
    unsafe {
        novella_rt_weak_release(*(object as void**));
        putchar(67);
    }
}

func main() -> int {
    unsafe {
        let parent = novella_rt_alloc(8, 8, destroyParent);
        let child = novella_rt_alloc(8, 8, destroyChild);
        novella_rt_retain(child);
        *(parent as void**) = child;
        *(child as void**) = novella_rt_weak_create(parent);
        // 读取 weak 先安全升级，成功时得到一份新的强引用。
        let promoted = novella_rt_weak_upgrade(*(child as void**));
        if (promoted != parent) {
            abort();
        }
        novella_rt_release(promoted);
        putchar(65);
        // child 局部强引用仍存活，weak 回边不能阻止 parent 析构。
        novella_rt_release(parent);
        if (novella_rt_weak_upgrade(*(child as void**)) != null) {
            abort();
        }
        // child 析构负责释放剩余 weak 控制块。
        novella_rt_release(child);
        putchar(90);
    }
    return 42;
}
